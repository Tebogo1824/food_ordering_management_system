{
  "name": "food_ordering_management_system",
  "version": "1.0.0",
  "description": "Static ordering page for Junxion Cafe, styled with custom CSS and Tailwind CSS.",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "node scripts/prepare-dist.js",
    "build": "npm run build:css && node scripts/copy-static.js",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./dist/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./dist/tailwind.css --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
